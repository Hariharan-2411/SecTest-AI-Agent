# --- Where the Iris extension repo lives (source of the reusable brain) ---
# Default assumes iris-orchestrator/ sits beside Extension/.
IRIS_SRC=../Extension/chrome-boiler

# --- Companion agent (the tool-runner container) ---
AGENT_URL=http://agent:8787
AGENT_TOKEN=change-me-shared-with-agent

# --- Orchestrator HTTP (dashboard + intake API + bot callbacks) ---
PORT=8790
DASHBOARD_TOKEN=change-me-dashboard

# --- LLM ENSEMBLE (two agents; both run, results compared) ---------------------
# PROPOSER agent: model 1 + model 2 both propose recon steps; the steps are UNIONED
# (max coverage). CRITIC agent: model 1 + model 2 both review; the STRICTEST verdict
# wins (safety). The 2nd model (LLM_FALLBACK_*/CRITIC_FALLBACK_*) is also the fallback
# for single-reply calls (chains/report) if the 1st errors or rate-limits.
# provider = groq | anthropic | openai-compatible (openrouter/ollama/vLLM/bedrock)

# Proposer — model 1 (e.g. Groq)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
# Proposer — model 2 (e.g. OpenRouter). Leave blank for single-model.
LLM_FALLBACK_PROVIDER=openai-compatible
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_MODEL=openrouter/free
LLM_FALLBACK_API_KEY=

# Critic — model 1 (e.g. Groq). Leave the whole CRITIC_* set blank to disable the critic.
CRITIC_PROVIDER=groq
CRITIC_MODEL=llama-3.3-70b-versatile
CRITIC_API_KEY=
# Critic — model 2 (e.g. OpenRouter)
CRITIC_FALLBACK_PROVIDER=openai-compatible
CRITIC_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
CRITIC_FALLBACK_MODEL=openrouter/free
CRITIC_FALLBACK_API_KEY=

# Optional cheaper model for high-volume parse steps.
LLM_PARSE_MODEL=

# --- Remote approval / notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# --- Run defaults ---
RECON_BUDGET=12
APPROVAL_TIMEOUT_MS=1800000

# Injection scanners (dalfox/sqlmap) in the agent. OFF by default (fail closed).
# Even when 'true', the orchestrator still asks you to approve each run, and the
# engagement policy must opt into destructive tools (confirm + allowDestructive).
AGENT_ALLOW_DESTRUCTIVE=false
